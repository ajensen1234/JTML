    /*Clock for Timing Speed*/
    /*(Milliseconds)*/
    clock_t start_clock_, update_screen_clock_;

    /*Store Post Matrix on Cost Functions*/
    PoseMatrix pose_storage_;

    /*Plan 008 U9 (Cut B): the run's stage script, built ONCE in Initialize
