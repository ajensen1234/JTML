    ui.pose_label->setText("Initializing STL model on GPU...");
    ui.qvtk_widget->update();
    ui.qvtk_widget->renderWindow()->Render();
    ui.qvtk_cpv->update();
    ui.qvtk_cpv->renderWindow()->Render();
    /*STL Information*/
