    JTML_DLL int GetFrameWidth();

    /*Get Is Initialized Correctly*/
    JTML_DLL bool IsInitializedCorrectly();

private:
    /*GPU Image*/
    GPUImage* gpu_image_;

    /*Image Size*/
    int height_;
    int width_;

    /*Model Initialized Correctly?*/
